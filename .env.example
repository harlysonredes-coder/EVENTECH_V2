# Copie para `.env` (já ignorado pelo Git) e preencha. NUNCA versione o .env real.

# OBRIGATÓRIA. Mínimo de 32 caracteres. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=SUBSTITUA_POR_CHAVE_ALEATORIA_DE_64_CARACTERES

# Banco de dados. Padrão (local): SQLite em arquivo.
# Produção: PostgreSQL, ex.: postgresql://usuario:senha@host:5432/eventech
DATABASE_URL=sqlite:///./eventech.db

# Opcionais
TOKEN_EXPIRE_MINUTES=30
# Origens permitidas para CORS, separadas por vírgula (vazio = CORS desativado)
CORS_ORIGINS=

# Somente para scripts.criar_admin_local em modo não interativo (deploy)
# ADMIN_EMAIL=
# ADMIN_NOME=
# ADMIN_SENHA=
